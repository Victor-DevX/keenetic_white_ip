#!/opt/bin/sh
export PATH="/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin:$PATH"

# Физический интерфейс для перезапуска (как в исходнике)
wan_interface="eth3"

# Хранение в RAM (/tmp) — 0% износа флеш-памяти
workdir="/tmp/wh_ip"
log="$workdir/reconnect.log"
state_file="$workdir/state"

max_tries=7
long_pause=300
max_log_size=10240

mkdir -p "$workdir"

log_msg() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$log"
}

rotate_log() {
    [ -f "$log" ] || return 0
    local log_size
    log_size=$(wc -c < "$log" 2>/dev/null)

    case "$log_size" in
        ''|*[!0-9]*) log_size=0 ;;
    esac

    if [ "$log_size" -gt "$max_log_size" ]; then
        if tail -n 75 "$log" > "${log}.tmp" && mv "${log}.tmp" "$log"; then
            log_msg "[SYS] Log rotated"
        fi
    fi
}

# --------------------------------------------------
# Фильтрация событий NDMS (только ppp0)
# --------------------------------------------------
[ -n "$address" ] || exit 0
[ "$interface" = "ppp0" ] || exit 0

is_gray_ip() {
    printf '%s\n' "$1" | grep -qE \
    '^(10\.|100\.6[4-9]\.|100\.[7-9][0-9]\.|100\.1[01][0-9]\.|100\.12[0-7]\.|172\.1[6-9]\.|172\.2[0-9]\.|172\.3[01]\.|192\.168\.)'
}

if is_gray_ip "$address"; then
    current_state="GRAY:$address"
else
    current_state="WHITE:$address"
fi

old_state=$(cat "$state_file" 2>/dev/null)

# --------------------------------------------------
# Обработка WHITE IP
# --------------------------------------------------
if ! is_gray_ip "$address"; then
    [ "$old_state" = "$current_state" ] && exit 0

    rotate_log
    printf '%s\n' "$current_state" > "$state_file"
    log_msg "УСПЕХ: Получен белый IP $address (было: ${old_state:-INIT})"

    exit 0
fi

# --------------------------------------------------
# Обработка CGNAT (GRAY IP)
# --------------------------------------------------
case "$old_state" in
    RUNNING_GRAY:*)
        exit 0
        ;;
esac

rotate_log
printf '%s\n' "RUNNING_$current_state" > "$state_file"
log_msg "ВНИМАНИЕ: Обнаружен CGNAT IP ($address). Запуск цикла реконнектов..."

# --------------------------------------------------
# Фоновый цикл (дергает eth3 через ifconfig)
# --------------------------------------------------
(
    try_nr=1

    while :; do
        state_now=$(cat "$state_file" 2>/dev/null)

        case "$state_now" in
            RUNNING_GRAY:*) ;;
            *) exit 0 ;;
        esac

        # Задержка перед реконнектом
        if [ "$try_nr" -eq "$max_tries" ]; then
            log_msg "Лимит попыток ($max_tries) исчерпан. Ожидание ${long_pause}с перед новым кругом..."
            sleep "$long_pause"
        else
            delay=$(( ($(date +%s) % 11) + 5 ))
            sleep "$delay"
        fi

        # Проверка состояния перед сбросом
        state_now=$(cat "$state_file" 2>/dev/null)
        case "$state_now" in
            RUNNING_GRAY:*) ;;
            *) exit 0 ;;
        esac

        # Реконнект через ifconfig eth3
        ifconfig "$wan_interface" down >/dev/null 2>&1
        sleep 2
        ifconfig "$wan_interface" up >/dev/null 2>&1

        # Счётчик попыток
        if [ "$try_nr" -eq "$max_tries" ]; then
            try_nr=1
        else
            try_nr=$((try_nr + 1))
        fi
    done
) &

exit 0
